# Production builds use the deployed backend when this is left empty.
# During `npm run dev`, the Vite proxy (/api) is used automatically to
# avoid CORS restrictions.
# VITE_API_URL=https://nba-mvp-predictions-0354ab92b6ca.herokuapp.com/

# Optional: change the proxy target (defaults to the deployed backend).
# VITE_PROXY_TARGET=https://nba-mvp-predictions-0354ab92b6ca.herokuapp.com

# Optional: run against a local backend instead of the proxy.
# VITE_API_URL=http://localhost:5000/
